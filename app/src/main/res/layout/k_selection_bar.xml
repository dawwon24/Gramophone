<?xml version="1.0" encoding="utf-8"?>
<!-- Gramophone K: top bar while songs are selected in a list (see KSelection) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceContainerHigh"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center_vertical"
    android:minHeight="?attr/actionBarSize"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageButton
        android:id="@+id/k_sel_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/k_selection_close"
        android:src="@drawable/ic_close"
        app:tint="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/k_sel_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:singleLine="true"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp" />

    <ImageButton
        android:id="@+id/k_sel_all"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/k_selection_all"
        android:src="@drawable/k_ic_select_all"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/k_sel_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/play"
        android:src="@drawable/ic_play_arrow"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/k_sel_playlist"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/add_to_playlist"
        android:src="@drawable/outline_library_add_24"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/k_sel_more"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more"
        android:src="@drawable/ic_more_vert_alt"
        app:tint="?attr/colorOnSurface" />

</LinearLayout>

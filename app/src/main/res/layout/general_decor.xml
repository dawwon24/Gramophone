<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/decor_height"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/song_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="24dp"
        android:fontFamily="sans-serif"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp"
        app:textFontWeight="600"
        tools:text="0 Song" />

    <!-- Gramophone K: search box in the free space of this row (invisible = just a spacer) -->
    <LinearLayout
        android:id="@+id/k_search_box"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:background="@drawable/k_search_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="2dp"
        android:visibility="invisible">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_search"
            app:tint="?attr/colorOnSurfaceVariant" />

        <EditText
            android:id="@+id/k_search_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@null"
            android:contentDescription="@string/k_search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text"
            android:paddingVertical="0dp"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/k_search_clear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/k_search_clear"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="9dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/create_playlist"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/rp_buttons"
            android:contentDescription="@string/create_playlist"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            app:icon="@drawable/outline_add_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="26dp"
            app:iconTint="?attr/colorPrimary"
            app:tooltipText="@string/create_playlist"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/play_all"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/rp_buttons"
            android:contentDescription="@string/play_all"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            app:icon="@drawable/ic_play_arrow"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="26dp"
            app:iconTint="?attr/colorPrimary"
            app:tooltipText="@string/play_all"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shuffle_all"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/rp_buttons"
            android:contentDescription="@string/shuffle_all"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            app:icon="@drawable/ic_shuffle"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="?attr/colorPrimary"
            app:tooltipText="@string/shuffle_all"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sort"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/rp_buttons"
            android:contentDescription="@string/sort"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_sort"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="?attr/colorPrimary"
            app:tooltipText="@string/sort" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/jumpUp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/rp_buttons"
            android:contentDescription="@string/scroll_to_albums"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            app:icon="@drawable/baseline_arrow_upward_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="?attr/colorPrimary"
            app:tooltipText="@string/scroll_to_albums"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/jumpDown"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/rp_buttons"
            android:contentDescription="@string/scroll_to_songs"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            app:icon="@drawable/baseline_arrow_downward_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="?attr/colorPrimary"
            app:tooltipText="@string/scroll_to_songs"
            tools:visibility="visible" />


    </LinearLayout>

</LinearLayout>
